        text status_description
    }
    ORDERS {
        int order_id PK NOT_NULL
        int order_tot_quantity NOT_NULL
        NUMERIC order_tot_price NOT_NULL
        int customer_id FK NOT_NULL
        int order_status_id FK NOT_NULL
    }
    STORE-PRODUCTS-SERVICES {
        int id PK NOT_NULL
        int store_id FK NOT_NULL
        int product_service_id FK NOT_NULL
        NUMERIC price NOT_NULL
        int stock NOT_NULL
