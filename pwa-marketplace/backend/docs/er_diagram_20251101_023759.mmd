        text category_description
        string category_pic_path
        int category_status_id FK NOT_NULL
    }
    ENTITY-STATUSES {
        int status_id PK NOT_NULL
        string status_code NOT_NULL
        text status_description
    }
    CITIES {
        int city_id PK NOT_NULL
        string city_name NOT_NULL
