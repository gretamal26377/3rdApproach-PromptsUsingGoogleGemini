# Dockerfile for backend-search service
FROM python:3.11-slim

WORKDIR /pwa-marketplace/backend

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Expose port for search service
EXPOSE 5002

# Entrypoint for search service (runs only the search API)
CMD ["gunicorn", "--workers=2", "--bind=0.0.0.0:5002", "app.shared.search_wsgi:app"]
