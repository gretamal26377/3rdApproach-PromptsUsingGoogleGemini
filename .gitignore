# IDE
# .vscode/ commented out because AI suggested in gral to commit project-wide settings suach as those in
# settings.json, extensions.json or launch.json. If you want to ignore all VSCode settings, uncomment the line below
#.vscode/

# Visual Studio
.vs/

# Node.js dependencies
# This line tells Git to ignore any folder named node_modules anywhere in your repository,
# at any depth
node_modules/
# Folder generated by a local package app to transpile JSX source code, then no
# need to be included in the repo.
# Adding build folders (like dist/, build/, or out/) to .gitignore 
# is recommended and considered best practice, as all of them
# can be regenerated from the source code + specific commands
dist/
build/
out/

*storybook.log
storybook-static

# Python envs
venv/
.venv*/
__pycache__/
*.pyc

# Migrations (keep if desired; often committed)
migrations/

# Database files
*.db

secrets
