    "version": "0.2.0",
    "configurations": [
    {
      "name": "Attach to debugpy",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "justMyCode": true
    }       
    {
      "type": "bashdb",
      "request": "launch",
      "name": "Debug entrypoint.sh (bash)",
      "program": "${workspaceFolder}/pwa-marketplace/backend/scripts/entrypoint.sh",
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "MYSQL_HOST": "db",
        "MYSQL_PORT": "3306"
      },
      "terminalKind": "integrated",
      "pathBash": "/bin/bash" // For Win: pathBash refers to BASH binary path in WSL filesystem
      
    }
  ]
}